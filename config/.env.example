# Copy to config/.env and fill in. config/.env is git-ignored — never commit it.
# docs/SETUP.md explains how to get each value.

# ── YouTube Data API v3 (Phase 1) ─────────────────────────────
YOUTUBE_DATA_API_KEY=

# ── LLM providers (Phase 2) — tried in this order; falls back on rate limits/errors ──
LLM_PROVIDERS=gemini,groq

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Ordered fallback list; free-tier limits are per model, so each model is a fallback step.
GEMINI_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=openai/gpt-oss-120b

# ── Email / SMTP (Phase 4) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=               # sender Gmail address
SMTP_APP_PASSWORD=       # 16-char Gmail App Password (not your normal password)
SENDER_NAME=             # name shown in the From: header and signature

SEND_MODE=DRY_RUN        # DRY_RUN | REDIRECT | LIVE
TEST_INBOX=              # REDIRECT mode delivers here — an inbox you own
LIVE_ALLOWLIST=          # comma-separated; LIVE mode only sends to these
AUTO_APPROVE=false

# ── Backend API (Phase 4) — shared secret between n8n and FastAPI ──
API_KEY=                 # generate: openssl rand -hex 32

# ── Storage ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/outreach.db
